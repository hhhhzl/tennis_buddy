<?xml version="1.0"?>
<robot name="front_box">

  <link name="front_box_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3048 0.40 0.10"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3048 0.40 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </link>

  <joint name="front_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_box_link"/>
    <origin xyz="0.3516 0 0.0992" rpy="0 0 0"/>
  </joint>

</robot>

